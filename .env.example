# ENV=prod включает проверки безопасности: приложение НЕ стартует с дефолтным
# SECRET_KEY, с CORS_ORIGINS=* или с дефолтным DB_PASSWORD.
ENV=dev

APP_HOST=0.0.0.0
APP_PORT=8002

# openssl rand -hex 32
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Точные origin'ы через запятую, без слэша на конце. "*" запрещён при ENV=prod.
CORS_ORIGINS=*

# База: либо DATABASE_URL, либо набор DB_*. DATABASE_URL имеет приоритет.
# DATABASE_URL=
DB_NAME=tots
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

MEDIA_DIR=media
MAX_UPLOAD_MB=25

# Каталог медиа на хосте для bind mount в docker-compose.prod.yml
MEDIA_HOST_DIR=/srv/tots/media

# ВНИМАНИЕ: app.sh применяет их при КАЖДОМ старте, перезаписывая пароль
# существующего админа. После первого входа — закомментировать.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
