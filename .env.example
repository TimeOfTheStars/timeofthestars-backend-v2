# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8002
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# CORS: список origin через запятую (или * для всех)
CORS_ORIGINS=*

# --- База данных ---
# Можно задать целиком DATABASE_URL, либо раздельные DB_* поля ниже
DATABASE_URL=
DB_NAME=tots
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Хранилище файлов ---
MEDIA_DIR=media
MAX_UPLOAD_MB=10
